layout(local_size_x=256) in;
uniform int shift;
shared uint bins[512];
shared uint invalidCount;
shared uint colorSum;
void main() {
    uint local=gl_LocalInvocationID.x;
    bins[local]=0u; bins[local+256u]=0u;
    if(local==0u) { invalidCount=0u; colorSum=0u; }
    barrier();
    uint i=gl_GlobalInvocationID.x;
    if(i<uint(N)) {
        float d=raw[i];
        bool valid=!(isnan(d)||isinf(d));
        if(shift==24) {
            if(!valid) atomicAdd(invalidCount,1u);
            if(s[INITIAL]!=0u) atomicAdd(colorSum,colorDifference(i,rgb(i)));
        }
        if(valid) {
            uint k=ordered(d);
            uint mask=shift==24 ? 0u : (0xffffffffu << uint(shift+8));
            uint bin=(k>>uint(shift))&255u;
            if((k&mask)==s[LO]) atomicAdd(bins[bin],1u);
            if((k&mask)==s[HI]) atomicAdd(bins[bin+256u],1u);
        }
    }
    barrier();
    if(bins[local]>0u) atomicAdd(s[local],bins[local]);
    if(bins[local+256u]>0u) atomicAdd(s[local+256u],bins[local+256u]);
    if(local==0u && shift==24) {
        atomicAdd(s[BAD],invalidCount); atomicAdd(s[DIFF],colorSum);
    }
}
