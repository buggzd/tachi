#version 310 es
precision highp float;
precision highp int;
layout(local_size_x=8,local_size_y=8) in;
layout(binding=0) uniform highp sampler2D depthMap;
layout(binding=1) uniform highp sampler2D seedMap;
layout(binding=2) uniform highp sampler2D previousMap;
layout(rgba32f,binding=0) writeonly uniform highp image2D resultMap;
uniform int phase;
// Two Jacobi rounds: load a two-pixel halo, compute the 10x10 intermediate,
// synchronize locally, then write only the 8x8 interior. No cross-group dependency.
shared float tileDepth[144];
shared vec2 tilePrevious[144];
shared vec2 tileSeed[144];
shared vec2 intermediate[100];
float d(ivec2 p){return texelFetch(depthMap,p,0).r;}
void main(){
 ivec2 p=ivec2(gl_GlobalInvocationID.xy),size=textureSize(depthMap,0);
 if(phase==0){
  if(any(greaterThanEqual(p,size)))return;
  float depth=d(p);vec2 value=vec2(0.);
  int radius=int(ceil(96.*float(size.x)/1920.));
  for(int e=0;e<2;e++)for(int k=1;k<=radius;k++){
   ivec2 q=p+ivec2((e==0?1:-1)*k,0);if(q.x<0||q.x>=size.x)break;
   float gap=max(0.,d(q)-depth),distance=max(0.,float(k-1)*1920./float(size.x));
   value[e]=max(value[e],gap*smoothstep(.025,.12,gap)*(1.-smoothstep(0.,96.,distance)));
  }

  imageStore(resultMap,p,vec4(value,0.,1.));return;
 }
 ivec2 origin=ivec2(gl_WorkGroupID.xy)*8-ivec2(2);
 for(int i=int(gl_LocalInvocationIndex);i<144;i+=64){
  ivec2 q=clamp(origin+ivec2(i%12,i/12),ivec2(0),size-ivec2(1));
  tileDepth[i]=d(q);tilePrevious[i]=texelFetch(previousMap,q,0).rg;
  tileSeed[i]=texelFetch(seedMap,q,0).rg;
 }
 barrier();
 for(int i=int(gl_LocalInvocationIndex);i<100;i+=64){
  ivec2 local=ivec2(i%10,i/10)+ivec2(1),q=origin+local;
  vec2 value=vec2(0.);
  if(all(greaterThanEqual(q,ivec2(0)))&&all(lessThan(q,size))){
   int center=local.y*12+local.x;float depth=tileDepth[center];
   value=tileSeed[center]*.35;float total=.35;
   for(int y=-1;y<=1;y++)for(int x=-1;x<=1;x++){
    ivec2 n=q+ivec2(x,y);if(any(lessThan(n,ivec2(0)))||any(greaterThanEqual(n,size)))continue;
    int index=center+y*12+x;
    float w=(1.-smoothstep(.015,.07,abs(depth-tileDepth[index])))*float(x==0?2:1)*float(y==0?1:2);
    value+=tilePrevious[index]*w;total+=w;
   }
   value=min(vec2(1.-depth),value/total);
  }
  intermediate[i]=value;
 }
 // Even lanes outside a partial edge workgroup must finish both barriers.
 barrier();
 if(any(greaterThanEqual(p,size)))return;
 int lx=int(gl_LocalInvocationID.x),ly=int(gl_LocalInvocationID.y);
 int center=(ly+2)*12+lx+2;float depth=tileDepth[center];
 vec2 value=tileSeed[center]*.35;float total=.35;
 for(int y=-1;y<=1;y++)for(int x=-1;x<=1;x++){
  ivec2 q=p+ivec2(x,y);if(any(lessThan(q,ivec2(0)))||any(greaterThanEqual(q,size)))continue;
  int index=center+y*12+x;
  float w=(1.-smoothstep(.015,.07,abs(depth-tileDepth[index])))*float(x==0?2:1)*float(y==0?1:2);
  value+=intermediate[(ly+1+y)*10+lx+1+x]*w;total+=w;
 }
 value=min(vec2(1.-depth),value/total);
 if(phase==8)value=vec2(1.,-1.)*.016*.85*(vec2(depth-.5)+.65*value);
 imageStore(resultMap,p,vec4(value,0.,1.));
}
